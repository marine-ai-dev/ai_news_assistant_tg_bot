# Copy to .env and adjust. .env is git-ignored and must never be committed.
# Every setting is optional; the defaults below are what the application uses.

# Free-form deployment label.
AI_NEWS_ENVIRONMENT=local

# Directory for local runtime state (git-ignored).
AI_NEWS_DATA_DIR=data

# SQLite file. Defaults to <AI_NEWS_DATA_DIR>/ai_news.sqlite3.
# AI_NEWS_DATABASE_PATH=data/ai_news.sqlite3

# DEBUG | INFO | WARNING | ERROR | CRITICAL
AI_NEWS_LOG_LEVEL=INFO

# console | json
AI_NEWS_LOG_FORMAT=console

# Reserved kill-switch. There is no auto-publish code path; setting this to true is
# rejected at startup. Every post requires explicit human approval of the exact
# draft version being published.
AI_NEWS_AUTO_PUBLISH_ENABLED=false

# ---------------------------------------------------------------------------
# Telegram publishing.
#
# The bot token from @BotFather. This is the only secret the application has.
# Leave it empty here — put the real value in .env, which is git-ignored.
# Anyone holding this token can post to your channel; treat it like a password.
AI_NEWS_TELEGRAM_BOT_TOKEN=

# Where approved posts go. Either a public channel username (@my_channel) or a
# numeric chat id (channels are usually negative, e.g. -1001234567890).
#
# Point this at a private test channel first. The destination is always shown
# before the publish confirmation, but the safest first send is one nobody sees.
AI_NEWS_TELEGRAM_CHANNEL=

# The single Telegram account allowed to use the private review bot. Not a
# secret, but it identifies a real person, so it stays out of git like the token.
# Find yours by running 'ai-news telegram whoami' and messaging the bot once.
AI_NEWS_TELEGRAM_OWNER_USER_ID=

# The bot must be an administrator of that channel with 'Post Messages'.
# Nothing else — no delete, no ban, no member management.
# Check the whole setup without sending anything:  ai-news telegram doctor
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# There is no LLM API key, by design. The editorial and writing layers are a
# Claude Code session exchanging JSON with this application, not an integration.
# ---------------------------------------------------------------------------
