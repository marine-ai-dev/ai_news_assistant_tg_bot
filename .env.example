# Copy to .env and adjust. .env is git-ignored and must never be committed.
# Every setting is optional; the defaults below are what the application uses.

# Free-form deployment label.
AI_NEWS_ENVIRONMENT=local

# Directory for local runtime state (git-ignored).
AI_NEWS_DATA_DIR=data

# SQLite file. Defaults to <AI_NEWS_DATA_DIR>/ai_news.sqlite3.
# AI_NEWS_DATABASE_PATH=data/ai_news.sqlite3

# DEBUG | INFO | WARNING | ERROR | CRITICAL
AI_NEWS_LOG_LEVEL=INFO

# console | json
AI_NEWS_LOG_FORMAT=console

# Reserved kill-switch. There is no auto-publish code path; setting this to true is
# rejected at startup. Every post requires explicit human approval of the exact
# draft version being published.
AI_NEWS_AUTO_PUBLISH_ENABLED=false

# ---------------------------------------------------------------------------
# Telegram publishing.
#
# The bot token from @BotFather. This is the only secret the application has.
# Leave it empty here — put the real value in .env, which is git-ignored.
# Anyone holding this token can post to your channel; treat it like a password.
AI_NEWS_TELEGRAM_BOT_TOKEN=

# Where approved posts go. Either a public channel username (@my_channel) or a
# numeric chat id (channels are usually negative, e.g. -1001234567890).
#
# Point this at a private test channel first. The destination is always shown
# before the publish confirmation, but the safest first send is one nobody sees.
AI_NEWS_TELEGRAM_CHANNEL=

# The single Telegram account allowed to use the private review bot. Not a
# secret, but it identifies a real person, so it stays out of git like the token.
# Find yours by running 'ai-news telegram whoami' and messaging the bot once.
AI_NEWS_TELEGRAM_OWNER_USER_ID=

# The bot must be an administrator of that channel with 'Post Messages'.
# Nothing else — no delete, no ban, no member management.
# Check the whole setup without sending anything:  ai-news telegram doctor
# ---------------------------------------------------------------------------

# A second destination, separate from AI_NEWS_TELEGRAM_CHANNEL, for 'ai-news auto once
# --test' — a real send nobody but you reads. Required for --test mode; not required
# for --dry-run or for the human review workflow.
AI_NEWS_TEST_CHANNEL=

# Where post images and downloadable files live. Every approved asset is a path
# relative to this directory; nothing outside it can ever be published.
AI_NEWS_MEDIA_DIR=media

# The public channel handle used in the forwarding call-to-action at the end of a
# post. Configured rather than typed into prose, so a writing session cannot
# mistype it.
AI_NEWS_CHANNEL_HANDLE=@learn_ai_easy

# Whether new drafts close with the invite-a-friend call-to-action, and its wording.
# The leading emoji varies per post so the footer does not read as a stamp.
AI_NEWS_CHANNEL_FOOTER_ENABLED=true
AI_NEWS_CHANNEL_FOOTER_TEXT=Запросити друзів

# ---------------------------------------------------------------------------
# Unattended NEWS pipeline (GitHub Actions + Gemini). Off by default. This automates
# NEWS only — selecting, writing and publishing one post from an official source, with
# every post still passing through the same validation and approval gate a human draft
# does, recorded under the actor "gemini:auto". PROMPT and TESTED_USE_CASE content is
# never touched by this: those stay a Claude Code session exchanging JSON with this
# application, same as always.
#
# Kill switch for LIVE publishing only. Anything other than an explicit truthy value is
# treated as off — this is what a scheduled GitHub Actions run obeys (a schedule always
# runs in "live" mode). 'ai-news auto once --dry-run' and '--test' both work while this
# stays false: a manual dry-run or test-channel dispatch should not need this switch
# armed, since that is what would also let the cron start publishing for real.
AI_NEWS_AUTOMATION_ENABLED=false

# Google AI Studio API key for the Gemini Developer API. Same handling as the Telegram
# token above: leave empty here, real value only in a git-ignored .env or (for the
# GitHub Actions workflow) a repository secret — never a real value in this file.
AI_NEWS_GEMINI_API_KEY=

# The Gemini model id. Read at call time, not hard-coded, so a model rename or a
# deliberate switch needs no code change.
AI_NEWS_LLM_MODEL=gemini-3.6-flash

# Maximum automated NEWS publications per Europe/Kyiv calendar day, counted across
# every workflow run that day. A scheduled run past the limit is a safe no-op.
AI_NEWS_DAILY_POST_LIMIT=3
# ---------------------------------------------------------------------------
