# Copy to .env and adjust. .env is git-ignored and must never be committed.
# Every setting is optional; the defaults below are what the application uses.

# Free-form deployment label.
AI_NEWS_ENVIRONMENT=local

# Directory for local runtime state (git-ignored).
AI_NEWS_DATA_DIR=data

# SQLite file. Defaults to <AI_NEWS_DATA_DIR>/ai_news.sqlite3.
# AI_NEWS_DATABASE_PATH=data/ai_news.sqlite3

# DEBUG | INFO | WARNING | ERROR | CRITICAL
AI_NEWS_LOG_LEVEL=INFO

# console | json
AI_NEWS_LOG_FORMAT=console

# Reserved kill-switch. There is no auto-publish code path; setting this to true is
# rejected at startup. Every post requires explicit human approval of the exact
# draft version being published.
AI_NEWS_AUTO_PUBLISH_ENABLED=false

# ---------------------------------------------------------------------------
# Not yet consumed — listed so it is clear where future secrets belong.
# Do NOT set these in Phase 1; nothing reads them.
#
#   AI_NEWS_LLM_PROVIDER      (Phase 4)
#   AI_NEWS_LLM_MODEL         (Phase 4)
#   AI_NEWS_LLM_API_KEY       (Phase 4)
#   AI_NEWS_TELEGRAM_BOT_TOKEN   (Phase 7)
#   AI_NEWS_TELEGRAM_CHANNEL_ID  (Phase 7)
# ---------------------------------------------------------------------------
